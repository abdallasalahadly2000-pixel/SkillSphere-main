# ---------------------------------------------------------------------------
# SkillSphere environment variables
# Copy this file to `.env.local` and fill in what you have.
# ---------------------------------------------------------------------------

# --- Supabase (database + auth + storage) ----------------------------------
# Project Settings -> API. The anon key is public by design and is safe in the
# browser; Row Level Security protects every row.
# Leave these empty to run the built-in local demo backend (see README).
NEXT_PUBLIC_SUPABASE_URL=https://yllkrlhsezyrsaimolbk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RLQeJ-ekgjZEtRcByYQRxg_yVx6oIrh

# --- AI (Gemini) -----------------------------------------------------------
# Google AI Studio -> Get API key. Server-side only, never prefixed NEXT_PUBLIC.
# Without a key the AI panel explains how to configure it instead of faking it.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional fallback provider (OpenAI-compatible) ------------------------
# Only used when GEMINI_API_KEY is empty. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Local demo backend ----------------------------------------------------
# Where the demo SQLite file lives (default: .data/skillsphere.db)
DEMO_DB_PATH=
